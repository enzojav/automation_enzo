PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Cuenta de Gmail que envía la notificación del formulario.
# NO uses tu contraseña normal: generá una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos
# activada en la cuenta de Gmail).
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres

# Opcional: a qué email llega el aviso de cada lead. Si no se define,
# se manda a la misma cuenta de SMTP_USER.
NOTIFY_EMAIL=tu-cuenta@gmail.com
